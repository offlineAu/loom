# Copy this file to .env.local and fill in your own Supabase project's
# values (Project Settings -> API in the Supabase dashboard).
#
# Both variables below are browser-safe by design — the anon/publishable
# key is meant to be shipped to the client. Access control comes entirely
# from Row Level Security (see supabase/migrations/), not from keeping this
# key secret. NEVER put a service_role/secret key in a NEXT_PUBLIC_* variable
# or anywhere else this app's client bundle can reach.
#
# LOOM runs fully without these set: anonymous/local trackers (Dexie) work
# with zero configuration. Leaving these unset simply means the /account
# page reports cloud accounts as "not configured" instead of offering sign-in.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" key (labeled "publishable key" in newer Supabase dashboards) —
# not the service_role/secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
